<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vishwakarma Mac host agent, as a LaunchAgent (runs in your login session,
  which Virtualization.framework needs). Edit the public host and the paths,
  then:
    cp io.vishwakarma.agent.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/io.vishwakarma.agent.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.vishwakarma.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/vishwakarma</string>
    <string>agent</string>
    <string>--public-host</string>
    <string>192.168.1.20</string>
    <string>--token-file</string>
    <string>/Users/YOU/.vishwakarma/token</string>
    <string>--tart</string>
    <string>/opt/homebrew/bin/tart</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Keep VMs running when the agent restarts; it adopts them again. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/.vishwakarma/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.vishwakarma/agent.log</string>
</dict>
</plist>
